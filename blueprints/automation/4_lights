                {% else %} 25
                {% endif %}
          - service: light.turn_on
            target:
              entity_id: "{{ l2 }}"
            data:
              brightness_pct: "{{ next_pct }}"

      # --- BUTTON 3 ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.payload == '3_single' }}"
        sequence:
